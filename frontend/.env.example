# Copy to each app's own .env — apps own their URLs, packages never read env directly.

# apps/web
VITE_API_URL=http://localhost:8000
VITE_WS_URL=ws://localhost:8000/ws

# apps/mobile (Android emulator uses 10.0.2.2 for host localhost)
EXPO_PUBLIC_API_URL=http://10.0.2.2:8000
EXPO_PUBLIC_WS_URL=ws://10.0.2.2:8000/ws
