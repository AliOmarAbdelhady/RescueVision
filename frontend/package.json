{
  "name": "rescuevision-frontend",
  "private": true,
  "version": "0.1.0",
  "description": "RescueVision frontend platform: Expo mobile app + React web dashboard + shared API gateway (monorepo)",
  "packageManager": "pnpm@9.15.0",
  "engines": {
    "node": ">=20.0.0"
  },
  "scripts": {
    "dev": "turbo run dev",
    "dev:web": "turbo run dev --filter=web",
    "dev:mobile": "turbo run dev --filter=mobile",
    "build": "turbo run build",
    "lint": "turbo run lint",
    "typecheck": "turbo run typecheck",
    "test": "turbo run test",
    "generate:api": "tsx tooling/scripts/generate-api.ts",
    "clean": "turbo run clean && rm -rf node_modules"
  },
  "devDependencies": {
    "turbo": "^2.3.0",
    "tsx": "^4.19.0"
  }
}
