# RescueVision Environment Variables
# Copy this file to .env and fill in values

# Dataset paths (overridden automatically on Kaggle)
DATA_ROOT=data
RAW_XBD_DIR=data/raw/xbd
PROCESSED_XBD_DIR=data/processed/xbd
RAW_FLOODNET_DIR=data/raw/floodnet

# Output paths
OUTPUTS_DIR=outputs
CHECKPOINTS_DIR=outputs/checkpoints

# Training
CUDA_VISIBLE_DEVICES=0

# Optional: Weights & Biases
# WANDB_API_KEY=your_key_here
# WANDB_PROJECT=rescuevision
